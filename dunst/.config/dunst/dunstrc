[global]
    ### Display ###
    follow = mouse

    ### Geometry ###
    width = (350, 350)
    origin = top-right
    offset = (12, 12)
    scale = 0
    notification_limit = 0
    gap_size = 4
    indicate_hidden = yes

    ### Progress bar ###
    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame_width = 1
    progress_bar_min_width = 350
    progress_bar_max_width = 350

    ### Appearance ###
    separator_height = 2
    padding = 8
    horizontal_padding = 8
    text_icon_padding = 6
    separator_color = frame
    corner_radius = 8
    sort = urgency_descending
    idle_threshold = 90
    frame_width = 3
    frame_color = "#61afef"
    background = "#1a212e"

    ### Text ###
    font = MonaspiceAr Nerd Font Propo 14
    markup = full
    format = "<b>%s</b>\n<i>%a</i>\n\n%b\n%p"
    alignment = right
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = false
    hide_duplicate_count = false
    show_indicators = yes

    ### Icons ###
    icon_position = off

    ### History ###
    sticky_history = yes
    history_length = 20

    ### Misc ###
    browser = /usr/bin/xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst
    ignore_dbusclose = false
    enable_posix_regex = true

    ### Mouse ###
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[experimental]
    per_monitor_dpi = false
    pause_on_mouse_over = true
    enable_pcre_regex = true

[hide-command-finished-notifications]
    summary = "Command finished"
    skip_display = true
    history_ignore = true

[urgency_critical]
    # use "Light" colours from my dotfiles
    background = "#e45649"
    foreground = "#0c0e15"
    highlight = "#833b3b"
    frame_color = "#833b3b"

    # Timeout in seconds before the notification is closed.
    # 0 = never times out (appropriate for critical)
    timeout = 0

    # Partial-pause escape hatch: this notification shows whenever
    # its override_pause_level exceeds dunst's current pause level
    # (set via `dunstctl set-pause-level N`).
    override_pause_level = 60

[urgency_low]
    # Use this as a "medium" notification, since that way can set it manually
    # like i do with critical
    foreground = "#e2c792"
    highlight = "#e2c792"
    frame_color = "#e2c792"

[urgency_normal]
