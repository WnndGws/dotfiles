
# Source this file in .zshrc

v() {
    local query="${*}"
    local -a matches

    if [[ -n $query ]]; then
        matches=(${(f)$(fasd -fl "$query")})
        if (( ${#matches[@]} == 0 )); then
            # no fasd history: fzf over $HOME with query pre-filled
            local sel
            sel=$(fd --type f --hidden --follow \
                    --exclude .git --exclude .cache --exclude .local/share \
                    . "$HOME" \
                | fzf --select-1 --query="$query") || return
            nvim "$sel"
        else
            local sel
            sel=$(printf '%s\n' "${matches[@]}" \
                | fzf --query="$query" --select-1) || return
            nvim "$sel"
        fi
    else
        # no arguments: browse $HOME
        local sel
        sel=$(fd --type f --hidden --follow \
                --exclude .git --exclude .cache --exclude .local/share \
            . "$HOME" | fzf) || return
        nvim "$sel"
    fi
}
